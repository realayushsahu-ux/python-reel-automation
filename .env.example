# OpenAI or DeepSeek OpenAI-compatible API
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-6-luna
AI_TRANSCRIPTION_MODEL=gpt-transcribe
# Cost savers: low-detail frames are ~10x fewer image tokens; local transcription is free.
AI_IMAGE_DETAIL=low
AI_FRAME_COUNT=4
# local = free faster-whisper on this PC, api = paid AI_TRANSCRIPTION_MODEL, off = skip
TRANSCRIBE_MODE=local
WHISPER_MODEL=base

# Commentary voiceover (Kokoro, free and local; run: pipeline.py setup-voice)
# English, or Hindi (Hindi voice + Hinglish on-screen captions)
COMMENTARY_LANGUAGE=English
# off | mild | strong - playful swear words in the voiceover only (never slurs, never at kids)
SLANG_LEVEL=off
# edge = free natural Microsoft neural voice (needs internet), kokoro = offline voice;
# edge falls back to kokoro automatically when it is unavailable
TTS_ENGINE=edge
# Edge voices that speak Hindi: en-US-AvaMultilingualNeural (expressive female),
# en-US-BrianMultilingualNeural (casual male), hi-IN-MadhurNeural, hi-IN-SwaraNeural
EDGE_VOICE=en-US-AvaMultilingualNeural
EDGE_RATE=+5%
# Lift tone per sentence (excited lines faster/higher, questions raised) so it sounds less read
EXPRESSIVE_VOICE=true
# Kokoro: leave empty for the default voice of the language (English af_heart, Hindi hm_psi);
# Hindi voices: hm_psi, hm_omega, hf_alpha, hf_beta
TTS_VOICE=
TTS_LANG=
TTS_SPEED=1.05
VOICE_GAIN=1.5
SOURCE_AUDIO_VOLUME=1.0
# Ready to Post rows queued before the commentary step get it added, this many per pass
UPGRADE_PER_PASS=2
# Invite the original creator as a collaborator when publishing (true/false)
INVITE_CREATOR_COLLAB=true
# Never set this to true unless you own the clip: raw reposts are what get flagged
ALLOW_RAW_REPOSTS=false

# Original Reels from free stock footage. Set ONE key; Pexels is used if both are set.
# Pixabay: free account, key shown at https://pixabay.com/api/docs/ when logged in.
# Pexels: https://www.pexels.com/api/ (new keys were paused in Nov 2026).
# Leave both empty to post commentary Reels only.
PIXABAY_API_KEY=
PEXELS_API_KEY=
ORIGINAL_SLOTS=11:00,22:00
ORIGINAL_NICHE=funny and surprising facts about animals, kids, food and everyday life
ORIGINAL_LOOKAHEAD_HOURS=36

# Google Sheets service account JSON file and spreadsheet ID
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET=Reel Queue
DOWNLOAD_MAX_ATTEMPTS=3
DOWNLOAD_RETRY_SECONDS=300
YTDLP_BROWSER=firefox
REJECTION_STATUS=REJECTED

# Stable Cloudflare Workers webhook relay (fill after deploying cloudflare-relay)
WEBHOOK_RELAY_URL=
WEBHOOK_RELAY_TOKEN=
WEBHOOK_RELAY_POLL_SECONDS=180

# Meta Login for Business (local development only)
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Replace with the HTTPS URL from a running Cloudflare Quick Tunnel, plus /meta/callback
META_REDIRECT_URI=https://example.com/meta/callback
META_GRAPH_VERSION=v26.0
# Set a private random string; use the same value in Meta's webhook verification form.
META_WEBHOOK_VERIFY_TOKEN=
# Webhook source/target account filters (IDs are app-scoped Instagram IDs, not secrets)
META_ALLOWED_SENDER_ID=
META_INSTAGRAM_ACCOUNT_ID=
