{
  "pack_name": "ReelFlow AI - Hindi/Hinglish Reaction Vocabulary",
  "version": "1.0.0",
  "language": "hi-Latn",
  "purpose": "A selectable vocabulary bank for context-aware, funny Hindi/Hinglish reaction commentary. This is not a script of fixed commentary lines.",
  "important_notes": [
    "Popularity labels are editorial starting estimates, not measured frequency rankings.",
    "Do not claim a word is currently trending unless supported by fresh platform-specific data.",
    "Use scene context, timing, repetition control, and platform suitability rather than inserting gaalis randomly.",
    "Never use caste, religion, race, disability, sexuality, gender-identity, or other protected-class slurs.",
    "Do not direct abuse at a real identifiable person. Prefer reactions to the action or situation.",
    "Strong profanity can reduce advertiser suitability and may be unsuitable for some audiences or platforms. Keep it opt-in."
  ],
  "selection_policy": {
    "default_intensity": "mild",
    "allowed_intensities": [
      "clean",
      "mild",
      "medium",
      "strong"
    ],
    "strong_profanity_enabled_by_default": false,
    "max_profanity_terms_per_clip": 1,
    "avoid_back_to_back_same_term": true,
    "avoid_same_root_within_last_n_reels": 5,
    "prefer_reaction_to_action_not_person": true,
    "use_clean_alternative_if_confidence_below": 0.72,
    "minimum_scene_confidence": 0.72,
    "commentary_length": "short; usually 2-8 words for a reaction beat",
    "timing": "Place the reaction just after the action becomes clear, not before the visual punchline."
  },
